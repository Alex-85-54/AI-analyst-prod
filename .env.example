# ClickHouse
CH_HOST=
CH_PORT=
CH_USER=
CH_PASSWORD=

# PostgreSQL (для агента-аналитика)
PG_HOST=
PG_PORT=5432
PG_USER=
PG_PASSWORD=
PG_DATABASE=

# LLM: провайдер — deepseek или openai
LLM_PROVIDER=deepseek

# DeepSeek API (при LLM_PROVIDER=deepseek)
API_KEY_DEEPSEEK=
DEEPSEEK_BASE_URL='https://api.deepseek.com/v1'

# OpenAI API (при LLM_PROVIDER=openai)
API_KEY_OPENAI=
OPENAI_MODEL=gpt-4o-mini
# Модели без поддержки параметра stop (через запятую). Для них используется обёртка без stop.
#OPENAI_MODELS_NO_STOP=gpt-5.2,o3,o4-mini

# Telegram
TELEGRAM_TOKEN=

# Security
AUTH_CONFIG_PATH=allowed_users.json

# Logging
LOG_FILE_PATH=logs/app.log
LOG_LEVEL=INFO
LOG_MAX_SIZE_MB=100
LOG_BACKUP_COUNT=5
LOG_ENABLE_CONSOLE=true

# App Settings
MAX_CONCURRENT_REQUESTS=50
REQUEST_TIMEOUT=60
DB_SCHEMA_PATH=app/agents/db_schema_docs.md
DB_SCHEMA_PATH_PG=app/agents/db_schema_pg.md

# Режим: dev — FAISS загружается/сохраняется на хосте; prod — FAISS каждый раз пересоздаётся
MODE=prod
# Директория для сохранения/загрузки индекса FAISS (только в mode=dev)
# FAISS_INDEX_PATH=cache/faiss_index